{
  "name": "outerflow",
  "private": true,
  "version": "0.1.0",
  "description": "Outerflow — Harboria Labs 3D prototyping, physics simulation, CAD, mathematical design, and experimental engineering studio",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
